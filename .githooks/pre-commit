#!/bin/sh
# Pre-commit hook: Run formatting checks

echo "🔍 Running pre-commit checks..."

# Rust formatting
cargo fmt --check
if [ $? -ne 0 ]; then
    echo "❌ Rust formatting failed. Run: cargo fmt"
    exit 1
fi

# Frontend formatting (if biome is available)
if command -v biome &> /dev/null; then
    biome check src/ --no-errors-on-unmatched
    if [ $? -ne 0 ]; then
        echo "⚠️  Biome check warnings (not blocking)"
    fi
fi

echo "✅ Pre-commit checks passed"
exit 0
