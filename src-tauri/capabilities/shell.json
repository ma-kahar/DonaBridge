{
  "$schema": "https://schemas.tauri.app/capability/1",
  "identifier": "shell",
  "description": "Capabilities for the React shell webview only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "dialog:default",
    "window-state:default",
    "autostart:default",
    "updater:default",
    "deep-link:default",
    "allow-list-accounts",
    "allow-prewarm-accounts",
    "allow-upsert-account",
    "allow-delete-account",
    "allow-switch-account",
    "allow-account-set-pin",
    "allow-account-verify-pin",
    "allow-account-clear-pin",
    "allow-set-overlay-open",
    "allow-crm-list-contacts",
    "allow-crm-upsert-contact",
    "allow-crm-delete-contact",
    "allow-crm-list-notes",
    "allow-crm-add-note",
    "allow-crm-list-reminders",
    "allow-crm-upsert-reminder",
    "allow-crm-list-templates",
    "allow-crm-upsert-template",
    "allow-crm-delete-template",
    "allow-crm-export-csv",
    "allow-crm-insert-draft",
    "allow-crm-set-drawer-open",
    "allow-crm-list-tags",
    "allow-crm-upsert-tag",
    "allow-crm-list-contact-tags",
    "allow-crm-assign-tag",
    "allow-crm-remove-tag",
    "allow-crm-import-csv",
    "allow-security-lock-status",
    "allow-security-set-pin",
    "allow-security-clear-pin",
    "allow-security-lock-app",
    "allow-security-unlock-pin",
    "allow-security-unlock-hello",
    "allow-secret-set",
    "allow-secret-has",
    "allow-secret-delete",
    "allow-ai-get-config",
    "allow-ai-save-config",
    "allow-ai-list-profiles",
    "allow-ai-upsert-profile",
    "allow-ai-set-active-profile",
    "allow-ai-delete-profile",
    "allow-ai-detect-models",
    "allow-ai-read-active-chat",
    "allow-ai-suggest-reply",
    "allow-mcp-status",
    "allow-mcp-start",
    "allow-mcp-stop",
    "allow-mcp-rotate-token"
  ]
}
