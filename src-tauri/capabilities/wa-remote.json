{
  "$schema": "https://schemas.tauri.app/capability/1",
  "identifier": "wa-remote",
  "description": "Capabilities for WhatsApp webviews (wa_*). Report-only — 7 commands. Auto-read when chat is open.",
  "webviews": ["wa_*"],
  "remote": {
    "urls": ["https://web.whatsapp.com/*"]
  },
  "local": false,
  "permissions": [
    "allow-wa-notify",
    "allow-wa-unread",
    "allow-wa-avatar",
    "allow-wa-chat-context",
    "allow-wa-shortcut",
    "allow-wa-auto-read",
    "allow-wa-session-state"
  ]
}
