{
  "name": "dona-bridge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc && vite build",
